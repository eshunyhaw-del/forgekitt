# Public browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Use your CURRENT live URL until you own the real domain (e.g. https://forgekitt.vercel.app)
NEXT_PUBLIC_SITE_URL=https://forgekitt.vercel.app
NEXT_PUBLIC_STORE_CURRENCY=GHS

# Server-only secrets — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
PAYSTACK_CURRENCY=GHS
SUPABASE_TEMPLATE_BUCKET=template-files
DOWNLOAD_LOG_SALT=replace-with-a-long-random-string

# Optional rate limiting (free Upstash Redis). Leave blank to disable — routes still work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
